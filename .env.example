# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Better Auth
BETTER_AUTH_SECRET=your-32-plus-character-random-secret-here
BETTER_AUTH_URL=https://your-app.vercel.app

# Vercel auto-sets VERCEL_URL at build time — no need to add manually

# R2 (optional — only needed for file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raw-takes
R2_PUBLIC_URL=

# API base URL (used by client-side code)
API_BASE_URL=https://your-app.vercel.app
