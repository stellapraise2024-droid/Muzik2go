{
  "name": "muzik2go-tokens",
  "version": "0.2.0",
  "comment": "Foil palette from reference image — flat fills only, no gradients. Cyan primary, Orange record, Chrome neutrals, Lime spark.",
  "color": {
    "bg": { "0": "#121A26", "1": "#1A2436" },
    "surface": { "1": "#222E44", "2": "#2A3850" },
    "border": "#3A4A66",
    "text": { "1": "#F2F5F9", "2": "#C7CDD6", "3": "#8A94A8" },
    "cyan": { "default": "#0AC8FF", "deep": "#0090C8", "ink": "#062A3A" },
    "orange": { "default": "#FF8A1A", "deep": "#D96A00", "ink": "#3A1E02" },
    "chrome": { "default": "#C7CDD6", "deep": "#8A94A8" },
    "lime": { "default": "#C8F04A", "ink": "#243000" },
    "iris": { "default": "#5B7CFF", "deep": "#3D5BE0", "ink": "#0E1638" },
    "error": "#FF453A",
    "warning": "#FFB020",
    "wave": { "played": "#0AC8FF", "unplayed": "#3A4A66" }
  },
  "role": {
    "primary": "{color.cyan.default}",
    "ai": "{color.iris.default}",
    "record": "{color.orange.default}",
    "spark": "{color.lime.default}"
  },
  "font": {
    "display": "Sora",
    "body": "Inter",
    "mono": "JetBrains Mono"
  },
  "radius": { "xs": 6, "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "space": [4, 8, 12, 16, 20, 24, 32, 48, 64]
}
