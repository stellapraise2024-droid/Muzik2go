{
  "name": "muzik2go-tokens",
  "version": "0.1.0",
  "comment": "Single source of truth — flat fills only, no gradients. Emerald primary, Purple AI, Pink record.",
  "color": {
    "bg": { "0": "#0B0F14", "1": "#111722" },
    "surface": { "1": "#161E2B", "2": "#1C2536" },
    "border": "#2A3650",
    "text": { "1": "#F4F6FB", "2": "#B9C2D4", "3": "#7D8AA3" },
    "emerald": { "default": "#10B981", "deep": "#059669", "ink": "#06281E" },
    "purple": { "default": "#8B5CF6", "deep": "#7C3AED", "ink": "#1B1040" },
    "pink": { "default": "#EC4899", "deep": "#DB2777", "ink": "#3B0A22" },
    "error": "#FF453A",
    "warning": "#FFB020",
    "wave": { "played": "#10B981", "unplayed": "#2E3B55" }
  },
  "role": {
    "primary": "{color.emerald.default}",
    "ai": "{color.purple.default}",
    "record": "{color.pink.default}"
  },
  "font": {
    "display": "Sora",
    "body": "Inter",
    "mono": "JetBrains Mono"
  },
  "radius": { "xs": 6, "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "space": [4, 8, 12, 16, 20, 24, 32, 48, 64]
}
